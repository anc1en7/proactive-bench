# OpenAI-compatible endpoint (e.g. OmniRoute). Copy to .env — never commit .env.
LLM_BASE_URL=https://example.com/v1
LLM_API_KEY=changeme
LLM_MODEL=rag

# Judge should differ from at least one agent model where possible.
JUDGE_MODEL=auto/best-reasoning

# Optional overrides
# LLM_TIMEOUT=120
# MAX_WORKERS=4
